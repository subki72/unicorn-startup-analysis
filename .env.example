# Unicorn Startup Analytics Configuration
# Copy this file to .env for local overrides (never commit .env)

DB_PATH=:memory:
DB_TIMEOUT_SECONDS=10.0
DEFAULT_NUM_COMPANIES=100
RANDOM_SEED=42
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000
LOG_LEVEL=INFO
RATE_LIMIT_PER_MINUTE=120
CACHE_TTL_SECONDS=60
API_HOST=0.0.0.0
API_PORT=8000
